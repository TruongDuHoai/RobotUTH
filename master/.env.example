# Robotuth v3 - Environment configuration
# Copy to .env and edit values as needed.
#
# The app loads this file itself (server/config.py -> load_dotenv), so PM2 can
# run `python -m server.main` directly. Real environment variables still win.
#
# Production shape: NO Docker. FastAPI runs under PM2 behind an nginx gateway on
# port 10010; Postgres is the shared instance also used by bookchat. See README.

# Server - bind loopback only; the nginx gateway is the sole public door.
HOST=127.0.0.1
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# Robot API token(s), comma-separated. MUST be non-empty in production: an empty
# value makes auth FAIL OPEN (every /api route reachable without a token).
# Generate with: openssl rand -base64 48
ROBOT_API_TOKENS=

# Face recognition (CPU-only on the host). Master switch - off by default; while
# off, every /api/attendance/face/* endpoint answers 503, the admin hub hides the
# card, and Redis is not needed (see REDIS_ENABLED below).
FACE_ENABLED=false
FACE_MODEL=buffalo_l
FACE_USE_GPU=false
FACE_MATCH_THRESHOLD=0.50
FACE_TOP_K=5
FACE_EMBEDDING_DIM=512

# PostgreSQL - shared instance (same host as bookchat). Create the user and the
# two databases once; start_system.sh does it for you.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=robotuth
POSTGRES_PASSWORD=change-me
POSTGRES_DB_FACE=robotuth_face
POSTGRES_DB_KNOWLEDGE=robotuth_knowledge

# Redis - only used by the face module (server/face/cache.py). Keep disabled while
# FACE_ENABLED=false; no Redis service is needed then.
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_ENABLED=false
RECOGNITION_CACHE_TTL_S=3

# LLM (9router, OpenAI-compatible) - reached directly, no :8006 proxy.
OPENAI_API_BASE=http://127.0.0.1:20128/v1
OPENAI_API_KEY=
# 9router combo alias (verified live); full ids like novita/google/gemma-4-31b-it also work.
# Do NOT use bare "gemma-4" - 9router returns 404 model_not_found for it.
OPENAI_MODEL=robot
REASONING_EFFORT=medium

LLAMA_SERVER_URL=http://localhost:8080
LLAMA_MODEL_PATH=
LLAMA_CTX_SIZE=2048

ASR_MODEL_PATH=
ASR_USE_GPU=false
# Host Parakeet CTC (:8002) on the same machine as the server.
# ASR provider: parakeet (host GPU) | deepgram (hosted Nova-3) | nemotron (host CPU)
ASR_PROVIDER=parakeet
ASR_BACKEND_URL=http://127.0.0.1:8002
# Nemotron (nvidia/nemotron-3.5-asr-streaming-0.6b) served by `nemo-speech serve`
# on ASR_BACKEND_URL. CPU-only, so the T400 stays free for other projects.
# Chosen over Whisper because it returns "" on silence instead of inventing text.
# NEMOTRON_LANGUAGE=vi-VN
# NEMOTRON_MODEL=nemotron-3.5-asr-streaming-0.6b
# NEMOTRON_TIMEOUT_SECONDS=30
# NEMOTRON_API_KEY=
# DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=vi
DEEPGRAM_SMART_FORMAT=true
# Comma-separated UTH names/phrases; keep under Deepgram keyterm limits.
DEEPGRAM_KEYTERMS=UTH,RobotUTH,Đại học Giao thông vận tải Thành phố Hồ Chí Minh
# Pre-tune optim (also set on host ASR process env)
ASR_TRIM_SILENCE=true
ASR_TRIM_PAD_MS=150
ASR_TRIM_RMS=0.01
ASR_DICT_ENABLED=true
# Streaming relay /ws/asr/{session} (server/api/asr_stream.py): client streams
# 100 ms PCM16 frames; server segments on silence and decodes each segment
# through the BATCH provider above - one model running, streaming capture.
# ASR_WS_SEGMENT_SILENCE_MS=900
# ASR_WS_MIN_SPEECH_MS=500
# ASR_WS_PRE_ROLL_MS=500
# ASR_WS_TURN_END=manual   # manual = push-to-talk stop frame; auto = hands-free
# ASR_WS_TURN_SILENCE_MS=1500
# ASR_WS_MAX_SESSION_S=120
# ASR_WS_MAX_SESSIONS=2
# Optional LLM STT polish (default off)
ASR_LLM_CORRECT=false
ASR_LLM_CORRECT_MAX_TOKENS=128
ASR_LLM_CORRECT_TIMEOUT_S=8

# Host PP-OCRv6 medium (det+rec) - deploy/gpu/ocr_gpu_server.py port 8003.
# Only needed to ingest scanned PDFs.
OCR_BACKEND_URL=http://127.0.0.1:8003
OCR_MIN_TEXT_CHARS=80
OCR_TIMEOUT_SECONDS=300

# Host VieNeu TTS - deploy/gpu/tts_gpu_server.py port 8004.
TTS_SERVICE_URL=http://127.0.0.1:8004
TTS_PROVIDER=vieneu
TTS_MODEL=google-tts/vi
TTS_VOICE=ngoc-huyen
TTS_ENABLED=true
TTS_TIMEOUT_SECONDS=45

KNOWLEDGE_ENABLED=true
KNOWLEDGE_TOP_K=5
KNOWLEDGE_CHUNK_SIZE=500
KNOWLEDGE_CHUNK_OVERLAP=50
KNOWLEDGE_MIN_SCORE=0.35
KNOWLEDGE_SEMANTIC_WEIGHT=0.7
KNOWLEDGE_KEYWORD_WEIGHT=0.3
KNOWLEDGE_EMBEDDING_MODEL=BAAI/bge-m3
KNOWLEDGE_UPLOAD_EXTENSIONS=.pdf,.docx,.txt
KNOWLEDGE_MAX_UPLOAD_MB=20
